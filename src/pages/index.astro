    <input class="cf-hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true">
    <label for="cfName">Your name</label>
    <input id="cfName" type="text" name="name" autocomplete="name" required>
    <label for="cfEmail">Your email</label>
    <input id="cfEmail" type="email" name="_replyto" autocomplete="email" required>
    <label for="cfMsg">Message</label>
    <textarea id="cfMsg" name="message" rows="5" required></textarea>
    <p class="cf-note">Messages are delivered by Formspree, a form service, after a quick spam check on its page. Your name and email are used only to reply.</p>
    <div class="cf-acts"><button class="btn" type="submit">Send message</button><button class="btn ghost" type="button" data-contact-close>Cancel</button></div>
    <p class="cf-status" id="contactStatus" role="status" aria-live="polite"></p>
  </form>
</dialog>
{CHAT_OPTIONS.enabled && <div class="sr" id="ijAnnounce" aria-live="polite"></div>}
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
	import '../scripts/home.js';
	import '../scripts/hero-rotator.js';
	import '../scripts/abt-motion.js';
</script>
</BaseLayout>
