import PlatformDiagram from '../components/PlatformDiagram.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import { CHAT_OPTIONS } from '../scripts/chat-options';
import { CASE_OPTIONS } from '../scripts/case-options';
import '../styles/home.css';
---

<BaseLayout
	title="Drake Kutz · Product Leader & Builder"
	description="Drake Kutz builds and scales digital products across payments, digital assets, compliance, and APIs, combining product leadership with hands-on technical execution."
	viewport="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
>
	<Fragment slot="head">
		<meta name="theme-color" content="#0A0B0D" />
		<meta name="color-scheme" content="dark" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,600&family=Geist+Mono:wght@400;500&family=Caveat:wght@600&display=swap" />
	</Fragment>
{/* ============ NAV ============ */}
<a class="skip" href="#main">Skip to content</a>
<header class="nav">
  <div class="w nin"><a class="brand" href="#home" data-go="home"><span class="logo">DK</span><span>Drake Kutz</span></a>
    <nav id="anav" class="links" aria-label="Primary" data-nav><a href="#work" data-go="home" data-anchor="work" data-work>Work</a><a href="#approach" data-go="home" data-anchor="approach">Approach</a><a href="#about" data-go="about">About</a></nav>
    <div class="nr"><button class="kbtn" data-cmdk-open aria-label="Open command menu"><span>Search</span><kbd>⌘K</kbd></button><a class="btn sm" href="#contact" data-go="home" data-anchor="contact">Contact</a><button class="menu-btn" data-menu aria-controls="anav" aria-expanded="false">Menu</button></div>
  </div>
</header>
<main id="main">
  {/* ============ HOME ============ */}
  <div data-view="home">
    {/* 1. Hero: the headline and introduction beside a rotating diagram of the six areas I work in
         (HeroDiagram.astro, driven by hero-rotator.js). Grid areas put it beside the copy on desktop,
         and between the headline and the introduction on phones. */}
