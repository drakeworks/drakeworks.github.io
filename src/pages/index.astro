<!-- ============ INTERVIEW ROOM: the chat widget ============ -->
<!-- Launcher in the corner → compact panel → full-screen chat app; phones get a full-screen sheet.
     data-mode is closed | compact | expanded | sheet. The INTERVIEW ROOM script fills the lists and messages. -->
<div class="ij" id="ij" data-mode="closed">
  <div class="ij-scrim" data-ij="collapse" aria-hidden="true"></div>
  <div class="ij-nudge" id="ijNudge" hidden>
    <button class="ij-nudge-open" type="button" data-ij="nudge"><span class="ij-av sm" aria-hidden="true">DK</span><span>Hiring for a product role? Ask me what panels usually ask.</span></button>
    <button class="ij-icon ij-nudge-x" type="button" data-ij="dismiss" aria-label="Dismiss"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 5.5l9 9m0-9l-9 9"/></svg></button>
  </div>
  <button class="ij-launch" id="ijLaunch" type="button" data-ij="launch" aria-controls="ijPanel" aria-expanded="false" aria-label="Ask Drake">
    <span class="ij-av" aria-hidden="true">DK<i class="ij-dot"></i></span>
    <span class="ij-launch-l">Ask Drake</span>
    <svg class="ij-chev" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 8l5 5 5-5"/></svg>
  </button>
  <section class="ij-panel" id="ijPanel" role="dialog" aria-labelledby="ijTitle" hidden>
    <div class="ij-wrap">
      <!-- Sidebar: shown when the panel is at least 860px wide (the expanded view on desktop) -->
      <aside class="ij-side" aria-label="Interview room">
        <div class="ij-prof"><span class="ij-av lg" aria-hidden="true">DK</span><div><b>Drake Kutz</b><span>Senior Product Manager</span></div></div>
        <p class="ij-status loc"><i></i>Charlotte, NC · Remote US</p>
        <div class="ij-side-acts">
          <button class="ij-sbtn" type="button" data-ij="new"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3.5H5A1.5 1.5 0 003.5 5v10A1.5 1.5 0 005 16.5h10a1.5 1.5 0 001.5-1.5v-5"/><path d="M14.2 3.3a1.4 1.4 0 012 2L10 11.5l-2.5.5.5-2.5z"/></svg>New chat</button>
          <button class="ij-sbtn" type="button" data-ij="all" aria-pressed="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5.5h9.5M7 10h9.5M7 14.5h9.5M3.5 5.5h.01M3.5 10h.01M3.5 14.5h.01"/></svg>Read all answers</button>
        </div>
        <div class="ij-qs" id="ijQs" role="group" aria-label="All ten questions"></div>
        <div class="ij-cases"><p>Prefer to read? Case studies</p><ul id="ijCases"></ul></div>
        <div class="ij-side-foot"><button class="btn sm" type="button" data-contact-open>Send a message</button><a class="btn sm ghost" href="#" data-link="linkedin" data-cta="Opens Drake’s LinkedIn profile.">LinkedIn</a></div>
      </aside>
      <div class="ij-main">
        <header class="ij-head">
          <span class="ij-av" aria-hidden="true">DK<i class="ij-dot"></i></span>
          <div class="ij-ttl"><h2 id="ijTitle" tabindex="-1">Ask Drake</h2><p><span class="ij-sub-long">Interview room · written answers</span><span class="ij-sub-short">Written answers</span></p></div>
          <div class="ij-tools">
            <button class="ij-icon ij-allbtn" type="button" data-ij="all" aria-pressed="false" aria-label="Read all answers" title="Read all answers"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5.5h9.5M7 10h9.5M7 14.5h9.5M3.5 5.5h.01M3.5 10h.01M3.5 14.5h.01"/></svg></button>
            <button class="ij-icon" type="button" data-ij="new" aria-label="New chat" title="New chat"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3.5H5A1.5 1.5 0 003.5 5v10A1.5 1.5 0 005 16.5h10a1.5 1.5 0 001.5-1.5v-5"/><path d="M14.2 3.3a1.4 1.4 0 012 2L10 11.5l-2.5.5.5-2.5z"/></svg></button>
            <button class="ij-icon ij-expand" id="ijExpand" type="button" data-ij="expand" aria-label="Expand to full screen" title="Expand"><svg class="ij-out" viewBox="0 0 20 20" aria-hidden="true"><path d="M12 3.5h4.5V8M8 16.5H3.5V12M16.5 3.5l-5 5M3.5 16.5l5-5"/></svg><svg class="ij-in" viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 8.5H11.5V4.5M4.5 11.5h4v4M11.5 8.5l5-5M8.5 11.5l-5 5"/></svg></button>
            <button class="ij-icon" type="button" data-ij="close" aria-label="Close the interview room" title="Close"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 5.5l9 9m0-9l-9 9"/></svg></button>
          </div>
        </header>
        <div class="ij-scroll" id="ijScroll">
          <div class="ij-log is-empty" id="ijLog"></div>
          <div class="ij-all" id="ijAll" hidden></div>
        </div>
        <div class="ij-sugg" id="ijSugg" role="group" aria-label="Suggested questions" hidden></div>
        <form class="ij-comp" id="ijForm">
          <label class="sr" for="ijInput">Ask Drake a question</label>
          <textarea id="ijInput" rows="1" enterkeyhint="send" autocomplete="off" placeholder="Ask about trade-offs, teams, results…"></textarea>
          <button class="ij-send" id="ijSend" type="submit" aria-label="Send" disabled><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 15.5v-11M5.5 9L10 4.5 14.5 9"/></svg></button>
        </form>
        <div class="ij-how">
          <p><span class="tok">[DISCLOSURE: how the answers are written, chosen in round 2]</span> <button type="button" data-ij="how" aria-expanded="false" aria-controls="ijHow">How this works</button></p>
          <p id="ijHow" hidden>A typed question is matched to the closest written answer by keywords, and the reply says which answer it matched. Each answer links to the case study behind it.</p>
        </div>
      </div>
    </div>
  </section>
</div>
